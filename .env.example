# ---- LLM -------------------------------------------------------------------------------------
# auto | offline | anthropic | openai.  "auto" uses a provider if its key is set, else offline.
# Install SDKs with: pip install -e ".[llm]"
LLM_BACKEND=auto
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
LLM_MODEL=                 # override the default model for the chosen provider
LLM_TIMEOUT=30
# Cost estimates use approximate built-in prices; override (USD per 1M tokens) to be accurate
# LLM_PRICE_IN=
# LLM_PRICE_OUT=
# Judge for `make eval-llm` (prefer a different model/provider than the one being evaluated)
# JUDGE_BACKEND=openai
# JUDGE_MODEL=gpt-4o-mini  # optional; do not reuse the evaluated model where possible

# ---- Retrieval -------------------------------------------------------------------------------
RETRIEVAL_MODE=hybrid      # bm25 | dense | hybrid
EMBEDDING_BACKEND=tfidf    # tfidf | lsa | sentence-transformers | openai
# For neural retrieval set EMBEDDING_BACKEND=sentence-transformers and install .[vector]
RERANKER=lexical           # lexical | cross-encoder | none   (cross-encoder needs ".[vector]")
RERANK=1
QUERY_REWRITE=1
CHUNK_STRATEGY=merged      # merged | section
VECTOR_STORE=auto          # auto | numpy | faiss | qdrant
# EMBEDDING_MODEL=BAAI/bge-small-en-v1.5   # for EMBEDDING_BACKEND=sentence-transformers (bge/e5 prefixes automatic)
# CROSS_ENCODER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
GRAPH_EXPAND=0             # 1 = reserve one result slot for a graph neighbour (see README: no gain measured)
# QDRANT_URL=http://localhost:6333   # unset = in-process; QDRANT_PATH=./qdrant_data for on-disk
# QDRANT_API_KEY=
ABSTAIN_THRESHOLD=0.23     # see `make calibrate`

# ---- Safety ----------------------------------------------------------------------------------
OUTPUT_GUARD=strict        # strict = replace ungrounded answers | flag = only record the flag
# If set, mode=manager requests must send header  X-Manager-Key: <this value>
MANAGER_API_KEY=
# If set, every endpoint except /health needs  X-API-Key: <this value>  (stops anonymous LLM spend)
API_KEY=
# If set, any request naming a user_id needs  X-User-Token: <hex HMAC>  minted by your backend with
# qsr_assistant.api.security.mint_user_token(user_id). Prevents reading another user's results.
USER_TOKEN_SECRET=
# APP_ENV=production        # refuse to start unless API_KEY, MANAGER_API_KEY, USER_TOKEN_SECRET are set

# ---- API ---------------------------------------------------------------------------------------
RATE_LIMIT_PER_MIN=60      # per-client requests/min (default 60), 0 = off
RATE_LIMIT_LLM_PER_MIN=20  # separate, tighter bucket for /chat*, /extract/ticket (default 20), 0 = off
TRUSTED_PROXY_HOPS=0       # behind N reverse proxies set N so the limiter sees real client IPs
# MCP_MODE=customer          # customer | manager (python -m qsr_assistant.mcp_server.server)

# ---- Observability ---------------------------------------------------------------------------
# TRACE_FILE=reports/traces.jsonl
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=https://cloud.langfuse.com

# ---- Misc ------------------------------------------------------------------------------------
LIVE_WEATHER=0
STORE_LAT=19.07
STORE_LON=72.87
# DATA_DIR=./data
# ARTIFACTS_DIR=./artifacts
